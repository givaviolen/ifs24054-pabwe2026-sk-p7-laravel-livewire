{
    "version": 2,
    "builds": [
        { "src": "api/index.php", "use": "vercel-php@0.7.3" },
        { "src": "/public/**", "use": "@vercel/static" }
    ],
    "routes": [
        {
            "src": "/build/(.*)",
            "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
            "dest": "/public/build/$1"
        },
        { "src": "/favicon.svg", "dest": "/public/favicon.svg" },
        { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
        { "src": "/robots.txt", "dest": "/public/robots.txt" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_CONFIG_CACHE": "/tmp/config.cache.php",
        "APP_EVENTS_CACHE": "/tmp/events.cache.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.cache.php",
        "APP_ROUTES_CACHE": "/tmp/routes.cache.php",
        "APP_SERVICES_CACHE": "/tmp/services.cache.php",
        "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "cookie",
        "DB_CONNECTION": "mysql",
        "QUEUE_CONNECTION": "sync",
        "FILESYSTEM_DISK": "local",
        "LOG_CHANNEL": "stderr"
    }
}